depmod -a

# Initialize mgmt rules
sh /usr/local/bin/es1010_mgmt_interface.sh

systemctl enable pddf-platform-init.service
systemctl enable es1010-pddf-platform-monitor.service

systemctl start pddf-platform-init.service
systemctl start es1010-pddf-platform-monitor.service

sh /usr/local/bin/sku_setup.sh
sh /usr/local/bin/poe_service_check.sh
