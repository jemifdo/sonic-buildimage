[Unit]
Description=PDDF module and device initialization service
Before=eg1050-pddf-platform-monitor.service
Before=pmon.service watchdog-control.service opennsl-modules.service
Before=system-health.service determine-reboot-cause.service config-setup.service
DefaultDependencies=no

[Service]
Type=oneshot
ExecStart=/usr/local/bin/pddf_util.py install
ExecStop=/usr/local/bin/pddf_util.py clean
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
WantedBy=opennsl-modules.service
